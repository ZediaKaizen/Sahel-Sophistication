# Port for the local Vite dev server.
# Not required on Netlify (Netlify manages its own server port).
PORT=3000

# URL base path the app is served under.
# Use "/" when deploying to the root of a domain (e.g. Netlify).
# Use "/my-path/" when serving at a sub-path.
# Netlify sets this automatically via netlify.toml [build.environment].
BASE_PATH=/
